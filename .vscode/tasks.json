{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Portfolio Server",
            "type": "process",
            "command": "python",
            "args": [
                "-m",
                "http.server",
                "8080",
                "--bind",
                "127.0.0.1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "portfolio-server",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Serving HTTP on",
                    "endsPattern": "^Serving HTTP on .* port 8080"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        }
    ]
}
